{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Harshit-ambati/IP-SAKTI-Sahayak/blob/main/contracts/v1/sahayak.schema.json",
  "title": "IP-SAKTI Sahayak v1 exchange objects",
  "$defs": {
    "Jurisdiction": {"enum": ["India", "international_overview"]},
    "Route": {"enum": ["classical_generic", "patent_proprietary", "novel_non_classical", "phytopharmaceutical", "ayurveda_aahara", "cosmetic", "unknown"]},
    "Intake": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "jurisdiction", "language", "question", "facts"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "request_id": {"type": "string", "minLength": 1},
        "jurisdiction": {"$ref": "#/$defs/Jurisdiction"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "question": {"type": "string", "minLength": 1},
        "facts": {"type": "object", "additionalProperties": {"type": ["string", "boolean", "null"]}}
      }
    },
    "ClassificationResult": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "route", "provisional", "missing_facts", "reason"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "request_id": {"type": "string", "minLength": 1},
        "route": {"$ref": "#/$defs/Route"},
        "provisional": {"const": true},
        "missing_facts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "EvidencePassage": {
      "type": "object", "additionalProperties": false,
      "required": ["passage_id", "source_id", "jurisdiction", "source_title", "source_url", "locator", "text", "review_status", "corpus_version"],
      "properties": {
        "passage_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "jurisdiction": {"$ref": "#/$defs/Jurisdiction"},
        "source_title": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "locator": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "review_status": {"enum": ["approved", "pending", "rejected", "stale"]},
        "corpus_version": {"type": "string", "minLength": 1}
      }
    },
    "Claim": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "AnswerResult": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "status", "jurisdiction", "language", "route", "assumptions", "claims", "evidence", "limitations", "corpus_version", "model_version"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "request_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["clarify", "answered", "abstained", "referral"]},
        "jurisdiction": {"$ref": "#/$defs/Jurisdiction"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "route": {"$ref": "#/$defs/Route"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/Claim"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/EvidencePassage"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "corpus_version": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "answered"}}}, "then": {"properties": {"claims": {"minItems": 1}, "evidence": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"enum": ["clarify", "abstained", "referral"]}}}, "then": {"properties": {"claims": {"maxItems": 0}}}}
      ]
    },
    "ReferralPacket": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "jurisdiction", "language", "question", "route", "assumptions", "evidence_ids", "unresolved_issues"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "request_id": {"type": "string", "minLength": 1},
        "jurisdiction": {"$ref": "#/$defs/Jurisdiction"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "question": {"type": "string", "minLength": 1},
        "route": {"$ref": "#/$defs/Route"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unresolved_issues": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
